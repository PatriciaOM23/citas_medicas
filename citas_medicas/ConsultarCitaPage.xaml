<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="citas_medicas.ConsultarCitaPage"
             Title="ConsultarCitaPage">
    <VerticalStackLayout>
        <Label 
            Text="Consultar citas"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontAttributes="Bold"
            FontSize="Title"
            Padding="20"/>

        <VerticalStackLayout
      Padding= "35,0"
      Spacing="10"
      >
            <CollectionView x:Name="listaCitas" >
                <CollectionView.EmptyView>
                    <ContentView>
                        <Label Text="Todavía no has solicitado ninguna cita."
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="16"
                   FontAttributes="Italic" />
                    </ContentView>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".05*" />
                                <ColumnDefinition Width=".1*"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Especialidad}" FontAttributes="Bold" FontSize="Medium" />
                                <Label Text="{Binding Doctor}" FontAttributes="Italic" FontSize="Small" />
                                <Label Text="{Binding DiasEspera}" FontAttributes="Italic" FontSize="Small" />
                                <Label Text="{Binding FechaSolicitud,StringFormat='Solicitada el {0:dd/MM/yyyy HH:mm}'}" FontAttributes="Bold" FontSize="Small" />


                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>