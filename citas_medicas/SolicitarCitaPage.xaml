<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="citas_medicas.SolicitarCitaPage"
             Title="SolicitarCitaPage">
    <VerticalStackLayout>
        <Label 
            Text="Nombre"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            FontAttributes="Bold"
            FontSize="13"/>
            
        <Entry
            x:Name="nombreEntry"
            Keyboard="Text"
            Placeholder="Patricia"
            HorizontalOptions="Center"
            MaxLength="50"
            WidthRequest="200"
            HeightRequest="40"

            
            />
        <Label 
             Text="Apellidos"
             VerticalOptions="Center" 
             HorizontalOptions="Center" 
             FontAttributes="Bold"
             FontSize="13"/>
        <Entry
            x:Name="apellidosEntry"
             Keyboard="Text"
             Placeholder="Olmedo Majano"
             MaxLength="50"
             WidthRequest="200"
             HeightRequest="40"
             HorizontalOptions="Center"
             />
        <Label 
              Text="Número de paciente"
              VerticalOptions="Center" 
              HorizontalOptions="Center"   
              FontAttributes="Bold"
              FontSize="13"/>
        <Entry
             x:Name="pacienteEntry"
              Keyboard="Numeric"
              Placeholder="1234567"
              MaxLength="7"
              HorizontalOptions="Center"
              WidthRequest="200"
              HeightRequest="30"
            

              />
       
        <Picker
            x:Name="turnoEntry"
            Title="Preferencia de turno"
            HorizontalOptions="Center"
            HeightRequest="50"
            WidthRequest="160"
           >
            
            <Picker.Items>
                <x:String>Mañana</x:String>
                <x:String>Tarde</x:String>
            </Picker.Items>
        </Picker>
        <HorizontalStackLayout HorizontalOptions="Center">
            <CheckBox
               x:Name="recordarDatos"
               IsEnabled="True"            
               HorizontalOptions="Center"/>
            <Label 
               Text="Recordar mis datos"
               VerticalOptions="Center" 
               HorizontalOptions="Center" />

        </HorizontalStackLayout>

        <VerticalStackLayout
            Padding= "35,0"
            Spacing="10"
            >
            <CollectionView x:Name="listaEspecialidades" SelectionMode="Single" SelectionChanged="listaEspecialidades_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".1*" />
                                <ColumnDefinition Width=".11*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Imagen}" HeightRequest="50" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="Micro" />
                                <Label Text="{Binding Doctor}" FontAttributes="Italic" FontSize="12"/>
                                <Label Text="{Binding DiasEspera}" FontAttributes="Italic" FontSize="11" />

                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>

        <Button
            x:Name="solicitarBtn"
            Text="Solicitar cita"
            Clicked="SolicitarCitaBtn_Clicked"
            HorizontalOptions="Center"/>
        
        

    </VerticalStackLayout>
</ContentPage>